package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "qcom.fmradio",
    srcs: ["qcom/fmradio/*.java"],
    platform_apis: true,
    system_ext_specific: true,
    installable: true,
}

prebuilt_etc {
    name: "qcom.fmradio.xml",
    src: "qcom.fmradio.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp_whitelist_com.caf.fmradio.xml",
    src: "privapp-permissions-com.caf.fmradio.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

android_app {
    name: "FM2",
    srcs: [
        "app/src/com/caf/fmradio/*.java",
        "app/src/com/caf/fmradio/*.aidl",
        "app/src/com/caf/hc_utils/*.java",
    ],
    aidl: {
        local_include_dirs: ["app/src"],
    },
    resource_dirs: ["app/res"],
    manifest: "app/AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    libs: ["qcom.fmradio"],
    uses_libs: ["qcom.fmradio"],
    required: [
        "qcom.fmradio.xml",
        "privapp_whitelist_com.caf.fmradio.xml",
    ],
    optimize: {
        enabled: false,
    },
}
